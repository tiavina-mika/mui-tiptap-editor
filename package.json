{
  "name": "mui-tiptap-editor",
  "version": "2.0.2",
  "description": "Easy to use Tiptap WYSIWYG rich text editor using Material UI (MUI) for React",
  "keywords": [
    "mui",
    "tiptap",
    "material-ui",
    "prosemirror",
    "rich text editor",
    "react text editor",
    "wysiwyg",
    "quill",
    "draftjs",
    "slate"
  ],
  "homepage": "https://github.com/tiavina-mika/mui-tiptap-editor",
  "bugs": {
    "url": "https://github.com/tiavina-mika/mui-tiptap-editor/issues"
  },
  "author": {
    "name": "Tiavina Michael Ralainirina",
    "email": "tiavinamika@gmail.com",
    "github": "https://github.com/tiavina-mika"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.mjs"
    }
  },
  "files": [
    "/dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts dev",
    "build:dev": "vite build --config vite.config.ts",
    "build": "rollup -c rollup.config.js",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:ui": "yarn test:e2e --ui",
    "test:e2e:headed": "yarn test:e2e --headed",
    "lint": "eslint . --ext .ts,.tsx --fix --max-warnings=1000",
    "precommit": "lint-staged",
    "prepare": "husky install",
    "sb": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "md-link:check": "markdown-link-check -v -p README.md -v -p CONTRIBUTING.md -v -p .github/**/*.md -c .markdown-link-check-config.json",
    "spell:check": "cspell \"{README.md,CONTRIBUTING.md,.github/*.md}\"",
    "upgrade:demos": "cd demos && yarn upgrade && rimraf ./demos/node_modules && yarn && yarn dev",
    "dev:demos": "cd demos && yarn dev"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@tiptap/extension-bubble-menu": "^3.29.2",
    "@tiptap/extension-code": "^3.29.2",
    "@tiptap/extension-code-block-lowlight": "^3.29.2",
    "@tiptap/extension-floating-menu": "^3.29.2",
    "@tiptap/extension-heading": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-mention": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-table-of-contents": "^3.29.2",
    "@tiptap/extension-text": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-text-style": "^3.29.2",
    "@tiptap/extension-typography": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/extension-youtube": "^3.29.2",
    "@tiptap/extensions": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/suggestion": "^3.29.2",
    "lowlight": "^3.3.0",
    "tippy.js": "^6.3.7"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@mui/material": "^9.3.1",
    "react": "^16.8.0 || ^17.0.2 || ^18.2.0 || ^19.2.0",
    "react-dom": "^16.8.0 || ^17.0.2 || ^18.2.0 || ^19.2.0"
  },
  "devDependencies": {
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@babel/runtime": "^8.0.0",
    "@chromatic-com/storybook": "5.3.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@cspell/eslint-plugin": "^10.0.1",
    "@emotion/babel-plugin": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource/roboto": "^5.3.0",
    "@mui/material": "^9.3.1",
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-url": "^8.0.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@storybook/addon-a11y": "10.5.6",
    "@storybook/addon-docs": "10.5.6",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-themes": "^10.5.6",
    "@storybook/addon-vitest": "10.5.6",
    "@storybook/react-vite": "10.5.6",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/eslint-plugin-jsx-a11y": "^6",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/rollup-plugin-peer-deps-external": "^2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-loader": "^10.1.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "cspell": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prefer-arrow-functions": "^3.10.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-storybook": "10.5.6",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.3.0",
    "markdown-link-check": "^3.15.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.4",
    "rollup-plugin-clear": "^2.0.7",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-filesize": "^10.0.0",
    "rollup-plugin-import-css": "^4.2.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-preserve-use-client": "^3.0.1",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-typescript2": "^0.37.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "semantic-release": "^25.0.9",
    "storybook": "10.5.6",
    "tiptap-parser": "^0.2.5",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@4.10.3"
}
